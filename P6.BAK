#include <stdio.h>
struct Account
{
    int pass;
    float balance;
};
void checkbalance(struct Account user);

void withdraw(struct Account *user);

void debit(struct Account *user);

int main()
{
    struct Account user;

    int choice;
    clrscr();
    user.pass = 9042;
    user.balance = 200000.87;

    do
    {
	printf("\n===============================\n");
	printf("        ENERGON BANK\n");
	printf("===============================\n");
	printf("1. Check Balance.\n2. Withdraw Cash\n3. Debit\n4. Exit\n");
	printf("==============================\n");

	printf("Enter your choice: ");
	scanf("%d", &choice);

	switch (choice)
	{
	case 1:
	    checkbalance(user);
	    break;

	case 2:
	    withdraw(&user);
	    break;

	case 3:
	    debit(&user);
	    break;

	case 4:
	    printf("\033[92mThank You for using the ENERGON BANK.(●'◡'●)\033[0m\n");
	    break;
	default:
	    printf("Error");
	    break;
	}
    } while (choice != 4);
    return 0;
}

void checkbalance(struct Account user)
{
    printf("\033[92mYour account Balance is Rs.%.2f.\033[0m", user.balance);
}

void withdraw(struct Account *user)
{
    float amount;
    printf("Enter the amount for withdrawal: ");
    scanf("%f", &amount);
    do
    {

	printf("\nEnter your account's PIN to proceed: ");
	scanf("%d", &user->pass);

	if (user->pass == 9042)
	{
	    if (user->balance >= amount)
	    {
		user->balance -= amount;
		printf("Amount withdrawn is %.2f.\n", amount);
		printf("Account Balance: %.2f.\n", user->balance);
	    }
	    else
	    {
		printf("\033[91mInsufficient Funds. Cannot Withdraw.\033[0m");
	    }
	}
	else
	{
	    printf("\033[91mIncorrect Password. Try Again.\033[0m");
	}
    } while (user->pass != 9042);
}

void debit(struct Account *user)
{
    char recipient[50];
    float amount;
    int success;
    success = 0;
    printf("\nEnter the Recipient's Name:  ");
    scanf("%49s", recipient);

    printf("\nEnter amount to be Debited: ");
    scanf("%f", &amount);

    do
    {
	printf("\nEnter your PIN to Proceed:  ");
	scanf("%d", &user->pass);

	if (user->pass == 9042)
	{
	    if (user->balance >= amount)
	    {
		user->balance -= amount;
		success = 1;
		printf("\nAmount Debited is %.2f.\n", amount);
	    }
	    else
	    {
		printf("\033[91mInsufficient Funds. Cannot Debit.\033[0m");
	    }
	}
	else
	{
	    printf("\033[91mIncorrect Password. Try Again.\033[0m");
	}
    } while (user->pass != 9042);

    if (success == 1)
    {
	printf("\n\033[92m-----Transaction-----\n");
	printf("Recipient : %s\n", recipient);
	printf("Amount    : Rs.%.2f\n", amount);
	printf("Status    : Successful\n");
	printf("Balance   : Rs.%.2f\n", user->balance);
	printf("---------------------\033[0m");
    }
    else
    {
	printf("\n\033[91m------------Transaction-Failed-------------\n");
	printf("Cause of Transaction Failure : Insufficient Funds.\n");
	printf("Recipient's Name             : %s\n", recipient);
	printf("Amount tried to Debit        : Rs.%.2f\n", amount);
	printf("Status of Debit              : Unsuccessful\n");
	printf("Account Balance              : Rs.%.2f\n", user->balance);
	printf("--------------------------------------------\033[0m\n");
    }
}