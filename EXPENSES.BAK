#include <stdio.h>
#include <conio.h>
void main ():
{
float expenses;
float total;
int tnp;
clrscr();
printf("How many did You spend Purchase today? ");
scanf("%d", &tnp);
printf("How much amount did you spend for each purchase? ");
while(tnp!=0)
{
scanf("%f", &expenses);
total =total+expenses;
tnp = tnp-1;
}
printf("Today's total expenses: %f", total);
getch();
}}