
#include <stdio.h>
#include <conio.h>

struct Employee
{
long int salary;
int experience;
long int id;
char name[50];
char designation[50];
};
void main()
{
struct Employee n1;
clrscr();
printf("Enter employee name: ");
scanf("%s",&n1.name);
printf("\nEnter Thy ID: ");
scanf("%ld",&n1.id);
printf("\nEnter thy Designation: ");
scanf("%s",&n1.designation);
printf("\nEnter thy experience: ");
scanf("%d",&n1.experience);
printf("\nEnter thy salary: ");
scanf("%ld",&n1.salary);
printf("\n\n");

printf("==================================\n");
printf("Employee Name          : %s\n",n1.name);
printf("Employee ID            : %ld\n",n1.id);
printf("Employee's Designation : %s\n",n1.designation);
printf("Employee's Experience  : %d\n",n1.experience);
printf("Employee's Salary      : %ld\n",n1.salary);
printf("==================================");

getch();
}